# Copy this file to terraform.tfvars and adjust as needed.
# terraform.tfvars is gitignored by default (see .gitignore) since it can
# hold environment-specific values -- for this lab there's nothing secret
# in it, but it's a good habit.

aws_region          = "us-east-1"
cluster_name        = "harness-fde-lab"
kubernetes_version  = "1.34"
node_instance_types = ["t3.medium"]
node_desired_size   = 2
node_min_size       = 1
node_max_size       = 3
